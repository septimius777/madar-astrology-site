# Copy this file to .env and fill in your own values. .env is gitignored.

PORT=3000
NODE_ENV=development

# The origin your Vite frontend runs on (dev server or production domain).
FRONTEND_ORIGIN=http://localhost:5173

# From @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# The chat/user/channel id the bot should send contact-form messages to.
# For a personal chat: message @userinfobot on Telegram to get your id.
TELEGRAM_CHAT_ID=

# --- Only needed if this server can't reach api.telegram.org directly ---
# (e.g. it's hosted somewhere Telegram is network-filtered, like Iran).
# Deploy the Cloudflare Worker in /worker (free, ~2 min, see README) and
# put its URL here instead of the default:
# TELEGRAM_API_BASE=https://medar-telegram-proxy.YOUR-SUBDOMAIN.workers.dev
TELEGRAM_API_BASE=https://api.telegram.org

# How long to wait for Telegram (or the Worker) before giving up (ms).
TELEGRAM_TIMEOUT_MS=10000
